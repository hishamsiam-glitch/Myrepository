{
  "name": "crate-quest",
  "version": "1.0.0",
  "private": true,
  "description": "Crate Quest: a crate-pushing puzzle game with 100 solver-verified levels (web + Android WebView shell).",
  "scripts": {
    "test": "node test/verify_levels.js",
    "test:ui": "node test/ui.test.js",
    "generate": "node --max-old-space-size=4096 tools/generate_levels.js",
    "icons": "node tools/render_icons.js",
    "serve": "npx --yes http-server web -p 8080 -c-1"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  },
  "license": "MIT"
}
